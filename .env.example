# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# --- Script generation (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Voiceover (ElevenLabs) — you said you already have this ---
ELEVENLABS_API_KEY=...
# Pick a voice that handles Gujarati well. Find IDs at https://elevenlabs.io/app/voices
# Leave blank to use the default multilingual voice set in config.yaml.
ELEVENLABS_VOICE_ID=

# --- Visuals (Pexels, free) — optional but recommended ---
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- YouTube upload ---
# OAuth client secrets JSON path (downloaded from Google Cloud Console).
# See README "YouTube setup". The token cache is created on first auth.
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json
